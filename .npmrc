# ESM-only package. Keep peer deps explicit; do not auto-install them.
auto-install-peers=false
strict-peer-dependencies=false
# Provenance is controlled by NPM_CONFIG_PROVENANCE in release.yml — currently "false" because this
# repo is PRIVATE today (sigstore rejects a private source repo with E422). The repo flips public at
# launch (FLIP-CHECKLIST row C5); turning provenance on is a FLIP-DAY change, deliberately not made
# early — it would fail every release until the flip actually happens.
